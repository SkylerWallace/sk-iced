+
+/// Repaint a superset of fragmented damage in one pass; pixel content is unchanged.
+/// The original behavior is selectable only during opt-in profiling comparisons.
+pub fn coalesce_damage(damage: Vec<Rectangle>) -> Vec<Rectangle> {
+    if damage.len() > 4 && !crate::profile::uncached() {
+        vec![
+            damage
+                .iter()
+                .skip(1)
+                .fold(damage[0], |bounds, r| bounds.union(r)),
+        ]
+    } else {
+        damage
+    }
+}
+#[cfg(test)]
+mod renderer_damage_tests {
+    use super::*;
+    #[test]
+    fn coalesced_damage_contains_every_original_region() {
+        let rects: Vec<_> = (0..10)
+            .map(|i| Rectangle {
+                x: 10.0,
+                y: i as f32 * 7.0,
+                width: 40.0,
+                height: 7.0,
+            })
+            .collect();
+        let grouped = coalesce_damage(rects.clone());
+        assert_eq!(grouped.len(), 1);
+        for rect in rects {
+            assert!(rect.is_within(&grouped[0]));
+        }
+        assert!(coalesce_damage(Vec::new()).is_empty());
+        assert_eq!(coalesce_damage(vec![grouped[0]]), grouped);
+    }
+}
